{
  "name": "@sg-transport/mrt-poller",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/with-repo-env.mjs node --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node ../../scripts/with-repo-env.mjs node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "fetch:gtfs": "node ../../scripts/with-repo-env.mjs tsx src/fetch-gtfs.ts"
  },
  "dependencies": {
    "@sg-transport/ports": "workspace:*",
    "@sg-transport/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
