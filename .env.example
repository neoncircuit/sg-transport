# Gateway
# PORT=8787
# TICK_MS=1000
# INGEST_STALE_MS=30000

# Bus poller → gateway
GATEWAY_URL=http://127.0.0.1:8787
# POLL_MS=2000
# BUS_SNAP=1               # snap buses onto bus.geojson (set 0 to disable)
# BUS_GEOJSON=             # default: packages/geometry-ts/data/bus.geojson

# LTA DataMall (leave empty until access is granted — poller uses fixtures/skeleton)
LTA_ACCOUNT_KEY=
# LTA_DATAMALL_BASE=https://datamall2.mytransport.sg/ltaodataservice
# Arrival is v3: {BASE}/v3/BusArrival?BusStopCode=…
# List APIs paginate: BusRoutes?$skip=500 (max 500 rows/call)

# Geometry extract (optional)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
