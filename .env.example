# Gateway — prefers 8787, then 8788, 8789, … if busy (writes .local/gateway.port)
# PORT=8787
# GATEWAY_HOST=127.0.0.1   # use 0.0.0.0 in Docker so pollers can reach it
# TICK_MS=1000
# INGEST_STALE_MS=30000
# INGEST_TOKEN=             # required on Railway; same secret on gateway + pollers

# Build identity (optional — defaults to `git describe --tags --always --dirty`)
# APP_VERSION=v0.1.0-7-gabcdef1
# GIT_SHA=abcdef1

# Bus poller → gateway (omit to auto-discover via .local/gateway.port / health probe)
# GATEWAY_URL=http://127.0.0.1:8787
# POLL_MS=2000          # default 2000; with LTA key defaults to 20000 (Arrival cadence)
# BUS_SNAP=1               # snap buses onto bus.geojson (set 0 to disable)
# BUS_GEOJSON=             # default: packages/geometry-ts/data/bus.geojson
# BUS_STOPS_GEOJSON=       # default: packages/geometry-ts/data/bus-stops.geojson

# LTA DataMall (never commit the key)
LTA_ACCOUNT_KEY=
# LTA_DATAMALL_BASE=https://datamall2.mytransport.sg/ltaodataservice
# Arrival is v3: {BASE}/v3/BusArrival?BusStopCode=…
# List APIs paginate: BusRoutes?$skip=500 (max 500 rows/call)
# LTA_BUS_STOPS=01012,01013,01019,01029   # optional override; else real codes from bus-stops.geojson
# LTA_HOT_STOPS=                           # optional; else CBD bbox from bus-stops.geojson
# LTA_ARRIVAL_BUDGET=40                    # Arrival calls per ~20s cycle (~173k/day)
# LTA_ARRIVAL_CONCURRENCY=8                # parallel Arrival fetches within a cycle
# BUS_GEOMETRY_SOURCE=auto                 # auto|live|local|fixture (extract:bus)
# BUS_ROUTE_SNAP=osrm                      # off (straight chords) | osrm (road-follow)
# OSRM_URL=https://router.project-osrm.org # public demo; self-host if rate-limited
# OSRM_CONCURRENCY=3                       # parallel OSRM edge requests (max 8)

# MRT schedule overlay (community GTFS → small JSON)
# pnpm --filter @sg-transport/mrt-poller fetch:gtfs
# Default zip: Vorld/singapore-gtfs (small). Optional large vibecode feed:
# MRT_GTFS_URL=https://media.githubusercontent.com/media/thecrapone/singapore-gtfs-2026/main/singapore-gtfs.zip
# MRT_GTFS_SCHEDULE_JSON=services/mrt-poller-ts/data/rail-gtfs-schedule.json

# ADS-B planes (services/adsb-poller-py — run separately from pnpm dev)
# ADSB_SOURCE=auto                         # auto|live|fixture|empty
# ADSB_FIXTURE=services/adsb-poller-py/fixtures/aircraft.json
# ADSB_LAT=1.35
# ADSB_LON=103.9
# ADSB_DIST_NM=50

# AIS ships (services/ais-poller-py — free key from https://aisstream.io/apikeys)
AIS_API_KEY=
# AIS_SOURCE=auto                          # auto|live|fixture|empty
# AIS_FIXTURE=services/ais-poller-py/fixtures/vessels.json
# AIS_STALE_MS=120000
# AIS_LAT_MIN=1.05
# AIS_LAT_MAX=1.48
# AIS_LON_MIN=103.50
# AIS_LON_MAX=104.15

# Windows corporate TLS (Node does not use the Windows store by default)
# powershell -File scripts/export-corp-ca.ps1
# Prefer a repo-relative path (works on Windows and WSL):
# NODE_EXTRA_CA_CERTS=.local/corp-ca.pem

# Geometry extract (optional)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
