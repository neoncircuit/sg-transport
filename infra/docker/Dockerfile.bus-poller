# syntax=docker/dockerfile:1

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate
WORKDIR /app

FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/shared-types-ts/package.json packages/shared-types-ts/
COPY packages/ports-ts/package.json packages/ports-ts/
COPY services/bus-poller-ts/package.json services/bus-poller-ts/
RUN pnpm install --frozen-lockfile --filter @sg-transport/bus-poller...
COPY packages/shared-types-ts packages/shared-types-ts
COPY packages/ports-ts packages/ports-ts
COPY services/bus-poller-ts services/bus-poller-ts
RUN pnpm --filter @sg-transport/bus-poller... build \
  && pnpm --filter @sg-transport/bus-poller deploy --prod --legacy /out

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV BUS_GEOJSON=/app/data/bus.geojson
ENV BUS_STOPS_GEOJSON=/app/data/bus-stops.geojson
COPY --from=build /out ./
COPY packages/geometry-ts/data/bus.geojson /app/data/bus.geojson
COPY packages/geometry-ts/data/bus-stops.geojson /app/data/bus-stops.geojson
USER node
CMD ["node", "dist/index.js"]
