# syntax=docker/dockerfile:1

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate
WORKDIR /app

FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/shared-types-ts/package.json packages/shared-types-ts/
COPY packages/ports-ts/package.json packages/ports-ts/
COPY apps/backend-ts/package.json apps/backend-ts/
RUN pnpm install --frozen-lockfile --filter @sg-transport/backend...
COPY packages/shared-types-ts packages/shared-types-ts
COPY packages/ports-ts packages/ports-ts
COPY apps/backend-ts apps/backend-ts
RUN pnpm --filter @sg-transport/backend... build \
  && pnpm --filter @sg-transport/backend deploy --prod --legacy /out

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8787
COPY --from=build /out ./
USER node
EXPOSE 8787
CMD ["node", "dist/index.js"]
