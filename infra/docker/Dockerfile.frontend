# syntax=docker/dockerfile:1

FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY scripts/app-version.mjs scripts/
COPY packages/shared-types-ts/package.json packages/shared-types-ts/
COPY apps/frontend-ts/package.json apps/frontend-ts/
RUN pnpm install --frozen-lockfile --filter @sg-transport/frontend...

COPY packages/shared-types-ts packages/shared-types-ts
COPY apps/frontend-ts apps/frontend-ts
# Public WebSocket URL of the gateway (e.g. wss://….up.railway.app/ws)
ARG VITE_WS_URL=
ENV VITE_WS_URL=$VITE_WS_URL
ARG APP_VERSION=0.0.0-dev
ARG GIT_SHA=unknown
ENV APP_VERSION=$APP_VERSION
ENV GIT_SHA=$GIT_SHA
RUN pnpm --filter @sg-transport/frontend build

FROM nginx:1.27-alpine AS runtime
COPY infra/docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/frontend-ts/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
